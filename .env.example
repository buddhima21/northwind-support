# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# The SA password for the local SQL Server container.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend ---------------------------------------------------------------
# Compose builds the connection string using sqlserver,1433 and MSSQL_SA_PASSWORD.
# Optional full override (must use sqlserver, not localhost, for the Compose SQL service):
# ConnectionStrings__Default=Server=sqlserver,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False
# ASP.NET Core uses "__" for nested settings. A host API started with npm run api
# instead uses localhost,1433 from appsettings.Development.json; dotnet run does
# not load this file. Export ConnectionStrings__Default in that terminal to override.

# Development turns on Swagger, the automatic migration and the demo seed data.
ASPNETCORE_ENVIRONMENT=Development

# Task 3 local demo fixture (documented here; the seeder hashes it before saving).
# Alex email: alex.turner@northwind.com
# Alex password: northwind_alexturner
# Other seeded agents keep Northwind_LocalDemo_Only1!; Yuki is inactive.
# The passwords above are documentation, not environment overrides.

# JWT settings. This public signing key is for local development only.
# Generate a separate random key outside development; never commit it.
# dotnet run does not automatically load .env; set environment variables in its shell.
Jwt__Issuer=NorthwindSupport.Local
Jwt__Audience=NorthwindSupport.Web
Jwt__SigningKey=Northwind_LocalDemo_Only_SigningKey_ChangeOutsideDevelopment_2026!
Jwt__LifetimeMinutes=60

# --- Frontend (set in the web terminal; Vite does not load the root .env) -----
# PowerShell: $env:VITE_API_PROXY_TARGET = 'http://localhost:5080'; npm run web
# Omit/unset this variable when using the host API and its default HTTPS port 7043.
